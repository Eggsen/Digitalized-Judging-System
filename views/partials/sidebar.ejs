                    <nav class="space-y-1.5" id="sidebar-admin-links">
                        <button type="button" data-tab="events-tab" title="Events &amp; Competitions" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl bg-buksu-navy text-white shadow-md transition-all cursor-pointer flex items-center gap-3 border border-buksu-gold/30">
