                    <button type="submit" id="saveCreateEventBtn" class="px-4 py-2 bg-buksu-navy hover:bg-buksu-navy-light text-white font-bold text-xs rounded-xl shadow cursor-pointer">Save Competition</button>
                </div>
            </form>
        </div>
