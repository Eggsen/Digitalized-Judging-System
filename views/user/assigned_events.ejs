            <!-- JUDGE / TABULATOR VIEW: ASSIGNED COMPETITIONS -->
            <div id="user-events-tab" class="user-tab-content bg-white dark:bg-slate-900 rounded-3xl shadow-xl border border-slate-100 dark:border-slate-800 p-6 sm:p-8">
                <div class="flex items-center justify-between flex-wrap gap-4 mb-6 border-b border-slate-100 dark:border-slate-800 pb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-buksu-navy text-buksu-gold flex items-center justify-center text-lg shrink-0 shadow-xs border border-buksu-gold/20">
                            <i class="fa-solid fa-clipboard-list"></i>
                        </div>
                        <div>
                            <h1 class="text-xl sm:text-2xl font-extrabold text-buksu-navy dark:text-slate-100">Assigned Competitions</h1>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Competitions and events where you are designated as an official <%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %>.</p>
                        </div>
                    </div>
                    <button id="refreshUserEventsBtn" class="text-xs text-slate-500 dark:text-slate-400 hover:text-buksu-navy dark:hover:text-buksu-gold font-semibold flex items-center gap-1 cursor-pointer transition-colors">
                        <i class="fa-solid fa-rotate-right"></i> Refresh List
                    </button>
                </div>

                <div id="user-assigned-events-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                    <div class="col-span-full py-12 text-center text-slate-400">
                        <i class="fa-solid fa-spinner fa-spin text-xl mb-2"></i>
                        <p class="text-xs">Loading assigned competitions...</p>
                    </div>
                </div>

                <!-- Pagination Controls for User Assigned Competitions -->
                <div id="user-events-pagination-container" class="flex items-center justify-between flex-wrap gap-4 mt-6 pt-5 border-t border-slate-100 dark:border-slate-800 text-xs hidden">
                    <div id="user-events-pagination-info" class="text-slate-500 dark:text-slate-400 font-medium">
                        Showing 0 to 0 of 0 competitions
                    </div>
                    <div class="flex items-center gap-3 flex-wrap">
                        <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400 font-medium">
                            <span>Per page:</span>
                            <select id="user-events-page-size" class="px-2.5 py-1 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer focus:outline-none">
                                <option value="6" selected>6</option>
                                <option value="9">9</option>
                                <option value="12">12</option>
                            </select>
                        </div>
                        <div id="user-events-pagination-controls" class="flex items-center gap-1.5 flex-wrap">
                            <!-- Injected dynamically -->
                        </div>
                    </div>
                </div>
            </div>
