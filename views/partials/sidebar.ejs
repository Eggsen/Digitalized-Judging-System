                            <span>Events &amp; Competitions</span>
                        </button>
                        <button type="button" data-tab="assignments-tab" title="Judge Assignments" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-3 border border-transparent">
