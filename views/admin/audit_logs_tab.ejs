            <!-- TAB 4: SYSTEM AUDIT LOGS -->
            <div id="logs-tab" class="admin-tab-content bg-white dark:bg-slate-900 rounded-3xl shadow-xl border border-slate-100 dark:border-slate-800 p-6 sm:p-8 hidden">
                <div class="flex items-center justify-between mb-6 border-b border-slate-100 dark:border-slate-800 pb-4">
                    <div>
                        <h2 class="text-xl font-extrabold text-buksu-navy dark:text-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-clock-rotate-left text-buksu-navy dark:text-buksu-gold"></i> System Audit Logs
                        </h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Chronological record of system actions, event creations, edits, archiving, and access updates.</p>
                    </div>
                    <div class="flex items-center gap-2 sm:gap-3">
                        <!-- Export Audit Trail Menu -->
                        <div class="relative inline-block text-left" id="logs-export-dropdown-container">
                            <button id="logs-export-btn" type="button" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-buksu-navy dark:text-slate-200 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-colors cursor-pointer shadow-xs">
                                <i class="fa-solid fa-file-export text-buksu-gold"></i>
                                <span>Export Report</span>
                                <i class="fa-solid fa-chevron-down text-[10px] ml-0.5 opacity-70"></i>
                            </button>
                            <div id="logs-export-menu" class="hidden absolute right-0 mt-1.5 w-52 bg-white dark:bg-slate-850 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 py-2 z-30">
                                <button type="button" id="logs-export-pdf-btn" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 flex items-center gap-2.5 cursor-pointer transition-colors">
                                    <div class="w-7 h-7 rounded-lg bg-rose-50 dark:bg-rose-950/50 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
                                        <i class="fa-solid fa-file-pdf text-sm"></i>
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800 dark:text-slate-100">Export Audit (PDF)</div>
                                        <div class="text-[10px] text-slate-400 font-normal">Governance summary memo</div>
                                    </div>
                                </button>
                                <button type="button" id="logs-export-csv-btn" class="w-full text-left px-3.5 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 flex items-center gap-2.5 cursor-pointer border-t border-slate-100 dark:border-slate-800 transition-colors">
                                    <div class="w-7 h-7 rounded-lg bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                                        <i class="fa-solid fa-file-csv text-sm"></i>
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800 dark:text-slate-100">Export Logs (CSV)</div>
                                        <div class="text-[10px] text-slate-400 font-normal">Spreadsheet & raw analytics</div>
                                    </div>
                                </button>
                            </div>
                        </div>

                        <button id="refreshLogsBtn" class="text-xs text-slate-500 dark:text-slate-400 hover:text-buksu-navy dark:hover:text-buksu-gold font-semibold flex items-center gap-1 cursor-pointer">
                            <i class="fa-solid fa-rotate-right"></i> Refresh
                        </button>
                    </div>
                </div>

                <!-- Search and Rows Filter Bar -->
                <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
                    <div class="relative flex-1 min-w-[240px] max-w-sm">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
                            <i class="fa-solid fa-magnifying-glass text-xs"></i>
                        </div>
                        <input 
                            type="text" 
                            id="logs-search-input" 
                            placeholder="Search logs by user, action, details..." 
                            class="w-full pl-9 pr-8 py-2 bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-buksu-navy/20 dark:focus:ring-buksu-gold/30 transition-all"
                        >
                        <button 
                            type="button" 
                            id="logs-search-clear-btn" 
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 cursor-pointer hidden" 
                            title="Clear search"
                        >
                            <i class="fa-solid fa-xmark text-xs"></i>
                        </button>
                    </div>

                    <!-- Role Filter -->
                    <div class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300">
                        <label for="logs-role-filter" class="font-semibold whitespace-nowrap flex items-center gap-1">
                            <i class="fa-solid fa-user-tag text-slate-400"></i> Role:
                        </label>
                        <select 
                            id="logs-role-filter" 
                            class="px-2.5 py-1.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-buksu-navy/20 dark:focus:ring-buksu-gold/30 cursor-pointer"
                        >
                            <option value="all">All Roles</option>
                            <option value="tabulator">Tabulator Only</option>
                            <option value="judge">Judge Only</option>
                            <option value="admin">Administrator Only</option>
                        </select>
                    </div>

                    <!-- Exact Date Filter -->
                    <div class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300">
                        <label for="logs-date-filter" class="font-semibold whitespace-nowrap flex items-center gap-1">
                            <i class="fa-regular fa-calendar text-slate-400"></i> Date:
                        </label>
                        <div class="relative flex items-center">
                            <input 
                                type="date" 
                                id="logs-date-filter" 
                                class="px-2.5 py-1.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-buksu-navy/20 dark:focus:ring-buksu-gold/30 cursor-pointer"
                                title="Filter by exact date"
                            >
                            <button 
                                type="button" 
                                id="logs-date-clear-btn" 
                                class="absolute right-2 text-slate-400 hover:text-rose-500 cursor-pointer hidden" 
                                title="Clear date filter"
                            >
                                <i class="fa-solid fa-circle-xmark text-xs"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Date Sort Order -->
                    <div class="flex items-center gap-1.5 text-xs text-slate-600 dark:text-slate-300">
                        <label for="logs-date-sort" class="font-semibold whitespace-nowrap flex items-center gap-1">
                            <i class="fa-solid fa-arrow-down-short-wide text-slate-400"></i> Sort:
                        </label>
                        <select 
                            id="logs-date-sort" 
                            class="px-2.5 py-1.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-buksu-navy/20 dark:focus:ring-buksu-gold/30 cursor-pointer"
                        >
                            <option value="desc">Newest First (Desc)</option>
                            <option value="asc">Oldest First (Asc)</option>
                        </select>
                    </div>

                    <div class="flex items-center gap-2 text-xs text-slate-600 dark:text-slate-300">
                        <label for="logs-page-size" class="font-semibold whitespace-nowrap">Show</label>
                        <select 
                            id="logs-page-size" 
                            class="px-2.5 py-1.5 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-xs font-bold text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-buksu-navy/20 dark:focus:ring-buksu-gold/30 cursor-pointer"
                        >
                            <option value="10">10</option>
                            <option value="25" selected>25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <span class="font-semibold whitespace-nowrap">rows</span>
                    </div>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700">
                    <table class="w-full text-xs">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-slate-850 border-b border-slate-200 dark:border-slate-700">
                                <th id="logs-timestamp-header-btn" class="px-4 py-3 text-left font-semibold text-slate-500 dark:text-slate-400 uppercase cursor-pointer hover:text-buksu-navy dark:hover:text-buksu-gold select-none transition-colors" title="Click to toggle ascending / descending date sort">
                                    Timestamp <i id="logs-sort-icon" class="fa-solid fa-arrow-down-wide-short ms-1 text-[11px] text-slate-400"></i>
                                </th>
                                <th class="px-4 py-3 text-left font-semibold text-slate-500 dark:text-slate-400 uppercase">User</th>
                                <th class="px-4 py-3 text-center font-semibold text-slate-500 dark:text-slate-400 uppercase">Action</th>
                                <th class="px-4 py-3 text-left font-semibold text-slate-500 dark:text-slate-400 uppercase">Details</th>
                            </tr>
                        </thead>
                        <tbody id="logs-tbody">
                            <tr>
                                <td colspan="4" class="px-4 py-6 text-center text-slate-400">
                                    <i class="fa-solid fa-spinner fa-spin me-1.5"></i> Loading audit logs...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer Container -->
                <div class="flex items-center justify-between flex-wrap gap-4 mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 text-xs">
                    <div id="logs-pagination-info" class="text-slate-500 dark:text-slate-400 font-medium">
                        Showing 0 items.
                    </div>
                    <div id="logs-pagination-controls" class="flex items-center gap-1.5 flex-wrap">
                    </div>
                </div>
            </div>
