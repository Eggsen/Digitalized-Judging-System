                            <span>User Invitations</span>
                        </button>
                        <button type="button" data-tab="logs-tab" title="Audit Logs" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-3 border border-transparent">
                            <i class="fa-solid fa-clock-rotate-left text-slate-400 w-4 text-center"></i>
                            <span>Audit Logs</span>
                        </button>

                        <!-- Notifications Hub Nav Item -->
                        <button type="button" data-tab="notifications-tab" id="sidebar-admin-notif-link" title="Notifications Hub" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center justify-between border border-transparent">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-bell text-slate-400 w-4 text-center"></i>
                                <span>Notifications Hub</span>
                            </div>
                            <span id="sidebarNotifBadgeAdmin" class="sidebar-notif-badge px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-500 text-white hidden">0</span>
                        </button>

                        <div id="sidebar-settings-group" class="space-y-1">
                            <button type="button" data-tab="settings-tab" title="System Settings" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center justify-between border border-transparent">
                                <div class="flex items-center gap-3">
                                    <i class="fa-solid fa-sliders text-slate-400 w-4 text-center"></i>
                                    <span>System Settings</span>
                                </div>
                                <i id="sidebar-settings-chevron" class="fa-solid fa-chevron-down text-[10px] text-slate-400 transition-transform duration-200"></i>
                            </button>
                            <!-- Sub-section for System Settings in Sidebar Mode -->
                            <div id="sidebar-settings-subnav" class="hidden ml-3 pl-3 border-l-2 border-slate-200 dark:border-slate-700/60 space-y-1 py-1">
                                <button type="button" data-subtab="settings-content-branding" title="Institution &amp; Branding" class="sidebar-settings-subtab-btn settings-subtab-btn w-full px-3 py-2 text-[11px] font-bold rounded-xl bg-buksu-navy text-white shadow-xs transition-all cursor-pointer flex items-center gap-2.5 text-left border border-buksu-gold/30">
                                    <i class="fa-solid fa-building-columns w-3.5 text-center text-[10px]"></i>
                                    <span class="truncate">Institution &amp; Branding</span>
                                </button>
                                <button type="button" data-subtab="settings-content-judging" title="Judging Rules" class="sidebar-settings-subtab-btn settings-subtab-btn w-full px-3 py-2 text-[11px] font-bold rounded-xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-2.5 text-left border border-transparent">
                                    <i class="fa-solid fa-scale-balanced text-slate-400 w-3.5 text-center text-[10px]"></i>
                                    <span class="truncate">Judging Rules</span>
                                </button>
                                <button type="button" data-subtab="settings-content-system-security" title="Security &amp; Infra" class="sidebar-settings-subtab-btn settings-subtab-btn w-full px-3 py-2 text-[11px] font-bold rounded-xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-2.5 text-left border border-transparent">
                                    <i class="fa-solid fa-shield-halved text-slate-400 w-3.5 text-center text-[10px]"></i>
                                    <span class="truncate">Security &amp; Infra</span>
                                    <span id="sidebar-system-security-tab-lock-icon" class="text-[9px] text-amber-500 ml-auto shrink-0"><i class="fa-solid fa-lock"></i></span>
                                </button>
                                <button type="button" data-subtab="settings-content-preferences" title="Preferences &amp; UI" class="sidebar-settings-subtab-btn settings-subtab-btn w-full px-3 py-2 text-[11px] font-bold rounded-xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-2.5 text-left border border-transparent">
                                    <i class="fa-solid fa-sliders text-slate-400 w-3.5 text-center text-[10px]"></i>
                                    <span class="truncate">Preferences &amp; UI</span>
                                </button>
                            </div>
                        </div>
                    </nav>
                    <% } else { %>
                    <!-- Navigation Links for Judge / Tabulator -->
                    <nav class="space-y-1.5" id="sidebar-user-links">
                        <button type="button" data-tab="user-events-tab" title="Assigned Competitions" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl bg-buksu-navy text-white shadow-md transition-all cursor-pointer flex items-center gap-3 border border-buksu-gold/30">
                            <i class="fa-solid fa-clipboard-list text-buksu-gold w-4 text-center"></i>
                            <span>Assigned Competitions</span>
                        </button>
                        <button type="button" data-tab="user-logs-tab" title="My Activity Logs" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-3 border border-transparent">
                            <i class="fa-solid fa-clock-rotate-left text-slate-400 w-4 text-center"></i>
                            <span>My Activity Logs</span>
                        </button>
                        <!-- Notifications Hub Nav Item -->
                        <button type="button" data-tab="notifications-tab" id="sidebar-user-notif-link" title="Notifications Hub" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center justify-between border border-transparent">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-bell text-slate-400 w-4 text-center"></i>
                                <span>Notifications Hub</span>
                            </div>
                            <span id="sidebarNotifBadgeUser" class="sidebar-notif-badge px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-500 text-white hidden">0</span>
                        </button>
                        <button type="button" data-tab="user-preferences-tab" title="Preferences" class="sidebar-nav-btn w-full px-4 py-3 text-xs font-bold rounded-2xl text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 transition-all cursor-pointer flex items-center gap-3 border border-transparent">
                            <i class="fa-solid fa-sliders text-slate-400 w-4 text-center"></i>
                            <span>Preferences</span>
                        </button>
                    </nav>
                    <% } %>
                </div>

                <!-- Sidebar Footer Status Card -->
                <div id="sidebar-footer-card" class="sidebar-footer p-3 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-500 space-y-1.5 shrink-0 bg-slate-50/70 dark:bg-slate-900/70">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-slate-600 dark:text-slate-400">Active Role</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700"><%= user.role %></span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-slate-400">Signed In As</span>
                        <span class="text-[10px] font-bold text-buksu-navy dark:text-buksu-gold truncate max-w-[120px]"><%= user.username %></span>
                    </div>
