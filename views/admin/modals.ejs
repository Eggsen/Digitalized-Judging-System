        <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-2xl max-w-md w-full p-6 sm:p-7 space-y-4 border border-slate-100 dark:border-slate-800 animate-fade-in flex flex-col text-center relative">
            <button type="button" id="closeAdminPinModalBtn" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-2xl cursor-pointer transition-colors leading-none">&times;</button>

            <div class="w-14 h-14 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center mx-auto text-2xl shadow-xs border border-amber-500/20">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
                <h3 class="text-lg font-black text-buksu-navy dark:text-slate-100 tracking-tight">Security &amp; Infrastructure 2FA</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    System security controls, third-party credentials, and database operations are protected. Enter your exclusive <strong>Admin PIN</strong> to authenticate and unlock.
                </p>
            </div>

            <div id="admin-pin-modal-notice" class="hidden p-2.5 rounded-xl text-xs font-semibold"></div>

            <form id="adminPinVerifyForm" onsubmit="return false;" class="space-y-4 pt-1">
                <div>
                    <label class="block text-[11px] font-bold text-slate-600 dark:text-slate-400 mb-1.5 uppercase tracking-wider">Your Exclusive Admin PIN</label>
                    <input type="password" id="admin-pin-input" autocomplete="off" placeholder="••••••••" class="w-56 mx-auto text-center tracking-[6px] text-xl font-black text-buksu-navy dark:text-slate-100 py-2.5 px-3 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-buksu-navy focus:bg-white transition-all font-mono">
                    <p class="text-[10px] text-slate-400 mt-1.5">Assigned exclusively to your administrator account</p>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" id="cancelAdminPinModalBtn" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" id="confirmAdminPinBtn" class="px-5 py-2.5 rounded-xl bg-buksu-navy hover:bg-buksu-navy-light text-white font-extrabold text-xs shadow-md transition-all flex items-center justify-center gap-2 border border-buksu-gold/30 cursor-pointer">
                        <i class="fa-solid fa-unlock text-buksu-gold"></i>
                        <span id="confirm-admin-pin-btn-text">Verify &amp; Unlock Section</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: PURGE SYSTEM AUDIT LOGS CONFIRMATION -->
    <div id="purge-logs-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-[85] hidden">
        <div class="bg-white dark:bg-slate-900 rounded-3xl shadow-2xl max-w-md w-full p-6 sm:p-7 space-y-4 border border-rose-100 dark:border-rose-900/40 animate-fade-in flex flex-col text-center relative">
            <button type="button" id="closePurgeLogsModalBtn" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-2xl cursor-pointer transition-colors leading-none">&times;</button>

            <div class="w-14 h-14 rounded-2xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center mx-auto text-2xl shadow-xs border border-rose-200 dark:border-rose-900/50">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <h3 class="text-lg font-black text-rose-700 dark:text-rose-400 tracking-tight">Purge Activity Audit Logs</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                    This action is permanent and cannot be undone. All recorded system activities, judge login audits, and admin logs will be permanently deleted.
                </p>
            </div>

            <div class="p-3.5 rounded-xl bg-rose-50/70 dark:bg-rose-950/30 border border-rose-200 dark:border-rose-900/50 text-left text-xs space-y-1.5">
                <div class="flex items-center justify-between text-rose-900 dark:text-rose-300 font-bold">
                    <span>Audit Records to Purge:</span>
                    <span id="purge-modal-count" class="font-black text-sm">0 entries</span>
                </div>
                <p class="text-[11px] text-rose-700 dark:text-rose-400">
                    To prevent accidental loss of audit history, type <strong class="font-mono bg-white dark:bg-slate-800 px-1.5 py-0.5 rounded border border-rose-300 dark:border-rose-700 text-rose-700 dark:text-rose-300">Confirm</strong> below to activate deletion.
                </p>
            </div>

            <form id="purgeLogsForm" onsubmit="return false;" class="space-y-3 pt-1">
                <div>
                    <input type="text" id="purge-confirm-input" autocomplete="off" placeholder="Type &quot;Confirm&quot; to proceed" class="w-full text-center font-bold text-sm text-slate-800 dark:text-slate-100 py-2.5 px-3 bg-slate-50 dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 rounded-xl focus:outline-none focus:border-rose-500 dark:focus:border-rose-500 focus:bg-white transition-all">
                </div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" id="cancelPurgeLogsModalBtn" class="px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-bold transition-colors cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" id="confirmPurgeLogsBtn" disabled class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 disabled:opacity-40 disabled:cursor-not-allowed text-white font-extrabold text-xs shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-trash-can"></i>
                        <span id="confirm-purge-btn-text">Purge Activity Logs</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: LOGO ASSET REPOSITORY / MEDIA LIBRARY -->
    <div id="logo-library-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden">
        <div class="bg-white rounded-3xl shadow-2xl max-w-2xl w-full p-6 space-y-4 max-h-[90vh] overflow-y-auto border border-slate-100 animate-fade-in flex flex-col relative">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center font-black shadow-xs border border-amber-200">
                        <i class="fa-solid fa-images text-lg"></i>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-slate-800 text-base leading-tight">Institution Logo Library</h3>
                        <p class="text-[11px] text-slate-500">Pick any previously uploaded logo or the system default seal with a single click</p>
                    </div>
                </div>
                <button type="button" id="closeLogoLibraryModalBtn" class="text-slate-400 hover:text-slate-600 text-2xl cursor-pointer p-1 transition-colors leading-none">&times;</button>
            </div>

            <!-- Quick Actions & Stats -->
            <div class="flex items-center justify-between gap-2 flex-wrap">
                <span id="logo-library-count-text" class="text-xs font-bold text-slate-600">Loading assets...</span>
                <div class="flex items-center gap-2">
                    <button type="button" id="uploadFromLibraryModalBtn" class="px-3 py-1.5 bg-buksu-navy hover:bg-buksu-navy-light text-white font-bold text-xs rounded-xl shadow-xs transition-all cursor-pointer flex items-center gap-1.5 border border-buksu-gold/30">
                        <i class="fa-solid fa-cloud-arrow-up text-buksu-gold"></i>
                        <span>Upload New Logo</span>
                    </button>
                    <button type="button" id="refreshLogoLibraryBtn" class="p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-all cursor-pointer" title="Refresh library">
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>
                </div>
            </div>

            <!-- Gallery Grid -->
            <div id="logo-library-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 min-h-[180px] overflow-y-auto max-h-[50vh] p-1">
                <div class="col-span-full py-12 text-center text-slate-400 text-xs">
                    <i class="fa-solid fa-spinner fa-spin text-xl text-buksu-navy mb-2 block"></i>
                    Loading logo repository...
                </div>
            </div>

            <!-- Footer -->
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                <span class="text-[11px]">Selected logo applies immediately to reports, boards, and scorecards</span>
                <button type="button" id="closeLogoLibraryModalFooterBtn" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-all cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>
