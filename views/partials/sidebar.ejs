                        <span id="sidebar-system-title" class="font-extrabold text-buksu-navy dark:text-white text-lg tracking-tight truncate block">
                            <%= (typeof branding !== 'undefined' && branding && branding.systemTitle && !branding.systemTitle.toLowerCase().includes('judgetab')) ? branding.systemTitle : 'DigiTab' %>
                        </span>
                    </a>

