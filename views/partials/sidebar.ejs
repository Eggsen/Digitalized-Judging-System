            <!-- Sidebar Navigation (Full Height Inset-Y-0 Sticked to Start/Left) -->
            <aside id="dashboard-sidebar-nav" class="dashboard-sidebar fixed inset-y-0 left-0 z-50 lg:z-40 w-64 sm:w-72 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col justify-between transition-all duration-300 -translate-x-full lg:translate-x-0 shadow-2xl lg:shadow-none">
                
                <!-- Sidebar Header (Aligned with topbar height h-16) -->
                <div class="sidebar-header h-16 px-4 flex items-center justify-between border-b border-slate-200 dark:border-slate-800 shrink-0 bg-white dark:bg-slate-900 transition-all duration-300">
