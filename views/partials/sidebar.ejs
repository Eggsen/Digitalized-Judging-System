                    <button type="button" id="sidebarCollapseBtn" class="p-2 text-slate-500 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-800 rounded-xl transition-colors cursor-pointer border border-transparent hover:border-slate-200 dark:hover:border-slate-700 shrink-0 flex items-center justify-center" aria-label="Toggle navigation menu" title="Toggle navigation menu">
                        <i class="fa-solid fa-bars text-base sm:text-lg"></i>
                    </button>
                </div>

                <!-- Scrollable Navigation Items -->
                <div class="sidebar-nav-container flex-1 overflow-y-auto p-4 space-y-4">

                    <% if (user.role === 'admin') { %>
