                <!-- Welcome Hero Card (Shown only on primary Events & Competitions tab) -->
                <div id="welcome-hero-card" class="rounded-3xl shadow-xl border border-slate-200/80 dark:border-slate-800 overflow-hidden bg-white dark:bg-slate-900 transition-all duration-300">
                    <!-- Top Section: BukSU Dark Blue Header (Compacted height for better above-the-fold visibility) -->
                    <div class="bg-gradient-to-r from-buksu-navy via-buksu-navy-light to-buksu-navy px-5 py-4 sm:px-8 sm:py-5 text-white relative">
                        <!-- Decorative ambient background glow & watermark -->
                        <div class="absolute top-0 right-0 w-72 h-72 bg-buksu-gold/10 rounded-full blur-3xl pointer-events-none"></div>
                        <div class="absolute -bottom-6 right-8 opacity-10 text-white pointer-events-none hidden sm:block">
                            <i class="fa-solid fa-scale-balanced text-8xl"></i>
                        </div>

                        <div class="relative z-10 flex items-center justify-between flex-wrap gap-3 sm:gap-4 min-w-0 max-w-full">
                            <div class="min-w-0 max-w-full">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] sm:text-xs font-bold bg-buksu-gold/20 text-buksu-gold border border-buksu-gold/30 mb-1.5 sm:mb-2 backdrop-blur-xs">
                                    <i class="fa-solid <%= badgeInfo.icon %>"></i> <%= user.role.toUpperCase() %> PORTAL
                                </span>
                                <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-white tracking-tight break-words">Welcome back, <%= user.full_name || user.username %>!</h1>
                                <p class="text-xs sm:text-sm text-slate-300 mt-1 font-normal flex items-center gap-2 min-w-0">
                                    <i class="fa-solid fa-circle-check text-emerald-400 text-[10px] shrink-0"></i>
                                    <span class="truncate"><%= user.email ? user.email : 'Authenticated user session active.' %></span>
                                </p>
                            </div>

                            <% if (user.role === 'admin') { %>
                                <button id="open-create-event-modal-btn"
                                    class="px-4 sm:px-5 py-2.5 bg-buksu-gold hover:bg-amber-400 text-buksu-navy font-black text-xs sm:text-sm rounded-2xl shadow-lg shadow-buksu-gold/25 hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center gap-2 cursor-pointer border border-yellow-300 shrink-0">
                                    <i class="fa-solid fa-plus text-buksu-navy font-black"></i> Create Competition
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Top Navigation Tabs Bar (Visible only when Top-Nav layout preference is active) -->
                <% if (user.role === 'admin') { %>
                    <div class="top-nav-bar rounded-2xl bg-white dark:bg-slate-900 shadow-md border border-slate-200/80 dark:border-slate-800 px-3 sm:px-6 py-2.5 w-full max-w-full overflow-hidden">
                        <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 scroll-smooth w-full min-w-0" id="admin-tabs">
                            <button data-tab="events-tab" class="admin-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl bg-buksu-navy text-white shadow-xs transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-trophy me-1.5"></i> Events &amp; Competitions
                            </button>
                            <button data-tab="assignments-tab" class="admin-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl text-slate-600 hover:bg-slate-100 hover:text-buksu-navy transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-user-check me-1.5 text-slate-400"></i> Judge Assignments
                            </button>
                            <button data-tab="users-tab" class="admin-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl text-slate-600 hover:bg-slate-100 hover:text-buksu-navy transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-users-gear me-1.5 text-slate-400"></i> User Invitations
                            </button>
                            <button data-tab="logs-tab" class="admin-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl text-slate-600 hover:bg-slate-100 hover:text-buksu-navy transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-clock-rotate-left me-1.5 text-slate-400"></i> Audit Logs
                            </button>
                            <button data-tab="notifications-tab" class="admin-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl text-slate-600 hover:bg-slate-100 hover:text-buksu-navy transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-bell me-1.5 text-slate-400"></i> Notifications Hub
                            </button>
                            <button data-tab="settings-tab" class="admin-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl text-slate-600 hover:bg-slate-100 hover:text-buksu-navy transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-sliders me-1.5 text-slate-400"></i> System Settings
                            </button>
                        </div>
                    </div>
                <% } else { %>
                    <div class="top-nav-bar rounded-2xl bg-white dark:bg-slate-900 shadow-md border border-slate-200/80 dark:border-slate-800 px-3 sm:px-6 py-2.5 w-full max-w-full overflow-hidden">
                        <div class="flex items-center gap-2 overflow-x-auto pb-1 sm:pb-0 scroll-smooth w-full min-w-0" id="user-tabs">
                            <button data-tab="user-events-tab" class="user-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl bg-buksu-navy text-white shadow-xs transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-clipboard-list me-1.5 text-buksu-gold"></i> Assigned Competitions
                            </button>
                            <button data-tab="user-logs-tab" class="user-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl text-slate-600 hover:bg-slate-100 hover:text-buksu-navy transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-clock-rotate-left me-1.5 text-slate-400"></i> My Activity Logs
                            </button>
                            <button data-tab="notifications-tab" class="user-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl text-slate-600 hover:bg-slate-100 hover:text-buksu-navy transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-bell me-1.5 text-slate-400"></i> Notifications Hub
                            </button>
                            <button data-tab="user-preferences-tab" class="user-tab-btn px-3 sm:px-4 py-2 text-xs font-bold rounded-xl text-slate-600 hover:bg-slate-100 hover:text-buksu-navy transition-all cursor-pointer shrink-0 whitespace-nowrap">
                                <i class="fa-solid fa-sliders me-1.5 text-slate-400"></i> Preferences
                            </button>
                        </div>
                    </div>
                <% } %>
