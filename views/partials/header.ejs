<%
    let safeHeaderTitle = 'DigiTab';
    if (typeof branding !== 'undefined' && branding && branding.systemTitle) {
        const titleStr = String(branding.systemTitle).trim();
        if (titleStr && !titleStr.toLowerCase().includes('judgetab')) {
            safeHeaderTitle = titleStr;
        }
    }
%>
    <!-- Header Navigation -->
    <header id="top-header-navigation" class="w-full max-w-full bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 sticky top-0 z-30 transition-all duration-300 overflow-x-clip">
        <div class="h-16 px-3 sm:px-6 lg:px-8 flex items-center justify-between gap-2 min-w-0">
            <div class="flex items-center gap-2 sm:gap-3 shrink-0 min-w-0">
                <!-- Hamburger Button (Visible on mobile, hidden on desktop when sidebar expanded) -->
                <button id="sidebarToggleBtn" type="button" aria-label="Toggle navigation menu" title="Toggle navigation menu"
                    class="p-2 -ml-1 text-slate-600 hover:text-buksu-navy hover:bg-slate-100 dark:text-slate-300 dark:hover:text-white dark:hover:bg-slate-800 rounded-xl transition-colors cursor-pointer border border-transparent hover:border-slate-200 dark:hover:border-slate-700 shrink-0 flex items-center justify-center">
                    <i class="fa-solid fa-bars text-base sm:text-lg"></i>
                </button>

                <!-- Brand link: Shows logo and title ONLY on mobile (< lg screens). On desktop, brand lives exclusively in the sidebar -->
                <a href="<%= (typeof dashboardUrl !== 'undefined' && dashboardUrl) ? dashboardUrl : (user.role === 'admin' ? '/admin/dashboard' : (user.role === 'tabulator' ? '/tabulator/dashboard' : '/judge/dashboard')) %>" id="topbar-brand-link" class="flex lg:hidden items-center gap-2 sm:gap-3 shrink-0 min-w-0 hover:opacity-90 transition-opacity">
                    <img id="top-nav-institution-logo" 
                         src="/assets/logo/DJS Logo.png" 
                         alt="DigiTab Logo" 
                         class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl object-contain bg-white dark:bg-slate-800 p-0.5 border border-slate-200 dark:border-slate-700 shadow-xs shrink-0">
                    <div class="min-w-0">
                        <span id="top-nav-system-title" class="font-extrabold text-buksu-navy dark:text-white text-base sm:text-lg tracking-tight truncate block">
                            <%= safeHeaderTitle %>
                        </span>
                    </div>
                </a>

                <!-- Breadcrumb / Section Header for Desktop Sidebar Mode -->
                <div id="topbar-context-title" class="hidden lg:flex items-center gap-2 text-xs font-bold text-slate-600 dark:text-slate-300 min-w-0">
                    <div id="topbar-breadcrumb-icon-container" class="w-8 h-8 rounded-xl bg-buksu-navy/5 dark:bg-white/5 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-buksu-navy dark:text-buksu-gold shrink-0">
                        <i id="topbar-breadcrumb-icon" class="fa-solid fa-trophy text-xs"></i>
                    </div>
                    <div class="min-w-0">
                        <span id="topbar-breadcrumb-category" class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block truncate leading-tight">DigiTab Platform</span>
                        <span id="topbar-breadcrumb-title" class="font-extrabold text-buksu-navy dark:text-white text-xs sm:text-sm tracking-tight block truncate leading-tight"><%= (typeof pageTitle !== 'undefined' && pageTitle && pageTitle !== 'Admin Dashboard' && pageTitle !== 'Dashboard') ? pageTitle : (user.role === 'admin' ? 'Events & Competitions' : 'Assigned Competitions') %></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
                <button id="logoutBtn" title="Sign Out"
                    class="px-3 sm:px-4 py-2 text-xs font-bold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl transition-colors cursor-pointer flex items-center gap-2 border border-rose-200 shrink-0">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    <span>Sign Out</span>
                </button>
            </div>
        </div>
    </header>
