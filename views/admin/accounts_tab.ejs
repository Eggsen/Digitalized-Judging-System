            <!-- TAB 3: USER INVITATIONS & ACCOUNTS -->
            <div id="users-tab" class="admin-tab-content bg-white dark:bg-slate-900 rounded-3xl shadow-xl border border-slate-100 dark:border-slate-800 p-6 sm:p-8 hidden">
                <div class="flex items-center gap-3 mb-6 border-b border-slate-100 dark:border-slate-800 pb-5">
                    <div class="w-10 h-10 rounded-xl bg-buksu-navy text-buksu-gold flex items-center justify-center text-lg shrink-0 shadow-xs border border-buksu-gold/20">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-extrabold text-buksu-navy dark:text-slate-100">User Account Management</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Send invitations to Judges &amp; Tabulators, and manage active permissions.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">
                    <!-- Send Invitation Form -->
                    <div class="lg:col-span-2">
                        <h3 class="text-sm font-bold text-buksu-navy mb-4 flex items-center gap-2">
                            <i class="fa-solid fa-paper-plane text-buksu-navy"></i> Send Account Invitation
                        </h3>

                        <div id="admin-create-notice-wrap" class="hidden mb-3">
                            <span id="admin-create-notice"></span>
                        </div>

                        <form id="createAccountForm" onsubmit="return false;" class="space-y-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Role <span class="text-rose-500">*</span></label>
                                <select id="create-role" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none">
                                    <% if (user && user.can_create_admin) { %>
                                        <option value="admin">Administrator</option>
                                    <% } %>
                                    <option value="judge" <%= (!user || !user.can_create_admin) ? 'selected' : '' %>>Judge</option>
                                    <option value="tabulator">Tabulator</option>
                                </select>
                            </div>

                            <div id="create-admin-pin-group" class="<%= (!user || !user.can_create_admin) ? 'hidden' : '' %>">
                                <label class="block text-xs font-semibold text-slate-700 mb-1.5 flex items-center justify-between">
                                    <span>Exclusive Admin PIN</span>
                                    <span class="text-[10px] text-amber-600 font-bold bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">Admin Only</span>
                                </label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 ps-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                                        <i class="fa-solid fa-key"></i>
                                    </div>
                                    <input type="text" id="create-admin-pin" maxlength="10" placeholder="Leave blank to auto-generate 6-digit PIN" class="w-full ps-9 pe-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 font-mono focus:outline-none">
                                </div>
                                <p class="text-[11px] text-slate-400 mt-1.5">Exclusive security PIN for unlocking API keys and .env variables. If left blank, a random 6-digit PIN will be generated.</p>
                            </div>

                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Email Address <span class="text-rose-500">*</span></label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 ps-3.5 flex items-center pointer-events-none text-slate-400 text-xs">
                                        <i class="fa-solid fa-envelope"></i>
                                    </div>
                                    <input type="email" id="create-email" maxlength="100" placeholder="user@buksu.edu.ph" class="w-full ps-9 pe-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none">
                                </div>
                                <p class="text-[11px] text-slate-400 mt-1.5">The user will provide their first and last name when accepting the invitation link.</p>
                            </div>

                            <button type="submit" id="createAccountBtn" class="w-full mt-4 py-2.5 px-4 bg-buksu-navy hover:bg-buksu-navy-light text-white font-bold text-xs rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer border border-buksu-gold/30">
                                <i class="fa-solid fa-paper-plane text-buksu-gold"></i>
                                <span id="create-btn-text">Send Invitation</span>
                            </button>
                        </form>
                    </div>

                    <!-- Accounts Table -->
                    <div class="lg:col-span-3">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
                            <div class="flex items-center gap-2">
                                <h3 class="text-sm font-bold text-buksu-navy flex items-center gap-2">
                                    <i class="fa-solid fa-list-ul text-buksu-navy"></i> Existing Accounts
                                </h3>
                                <span id="accounts-total-badge" class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-slate-100 text-slate-700 border border-slate-200">0</span>
                            </div>
                            <button id="refreshAccountsBtn" class="text-xs text-slate-600 hover:text-buksu-navy transition-colors flex items-center gap-1.5 cursor-pointer px-3 py-1.5 rounded-xl border border-slate-200 hover:bg-slate-50 self-start sm:self-auto font-semibold">
                                <i class="fa-solid fa-rotate-right text-slate-400"></i> Refresh
                            </button>
                        </div>

                        <!-- Filters & Page Size Toolbar -->
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5 mb-3 bg-slate-50 p-2.5 rounded-2xl border border-slate-200">
                            <div class="relative flex-1 min-w-[160px]">
                                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                    <i class="fa-solid fa-magnifying-glass text-xs"></i>
                                </div>
                                <input type="text" id="accounts-search-input" placeholder="Search name or email..." class="w-full pl-9 pr-3 py-1.5 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-buksu-navy">
                            </div>
                            <div class="flex items-center gap-2">
                                <select id="accounts-role-filter" class="px-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 focus:outline-none cursor-pointer">
                                    <option value="all">All Roles</option>
                                    <option value="admin">Administrator</option>
                                    <option value="judge">Judge</option>
                                    <option value="tabulator">Tabulator</option>
                                </select>
                                <div class="flex items-center gap-1.5 text-xs text-slate-600 whitespace-nowrap">
                                    <span class="text-[11px] font-semibold text-slate-500">Show</span>
                                    <select id="accounts-page-size" class="px-2 py-1.5 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-700 focus:outline-none cursor-pointer">
                                        <option value="5">5</option>
                                        <option value="10" selected>10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                    </select>
                                    <span class="text-[11px] font-semibold text-slate-500">rows</span>
                                </div>
                            </div>
                        </div>

                        <div id="admin-perm-notice-wrap" class="hidden mb-3">
                            <span id="admin-perm-notice"></span>
                        </div>

                        <div id="accounts-table-wrap" class="overflow-x-auto rounded-2xl border border-slate-200 bg-white">
                            <table class="w-full text-xs">
                                <thead>
                                    <tr class="bg-slate-50 border-b border-slate-200">
                                        <th class="px-4 py-3 text-left font-semibold text-slate-500 uppercase">Username / Email</th>
                                        <th class="px-4 py-3 text-center font-semibold text-slate-500 uppercase">Role</th>
                                        <th class="px-4 py-3 text-center font-semibold text-slate-500 uppercase">Status</th>
                                        <th class="px-4 py-3 text-center font-semibold text-slate-500 uppercase">Access</th>
                                    </tr>
                                </thead>
                                <tbody id="accounts-tbody">
                                    <tr>
                                        <td colspan="4" class="px-4 py-6 text-center text-slate-400">
                                            <i class="fa-solid fa-spinner fa-spin me-1.5"></i> Loading accounts...
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Footer Container -->
                        <div id="accounts-pagination-container" class="flex items-center justify-between flex-wrap gap-3 mt-4 pt-4 border-t border-slate-100 text-xs">
                            <div id="accounts-pagination-info" class="text-slate-500 font-medium">
                                Showing 0 items.
                            </div>
                            <div id="accounts-pagination-controls" class="flex items-center gap-1.5 flex-wrap">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
