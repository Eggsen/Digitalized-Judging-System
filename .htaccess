# Prevent directory listing
Options -Indexes

# Default document
DirectoryIndex index.php

# Deny direct browser access to sensitive files
<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|\.dockerignore|Dockerfile)$">
    Require all denied
</FilesMatch>

# Deny direct access to vendor and internal logs
RedirectMatch 403 ^/backend/logs/
RedirectMatch 403 ^/vendor/

