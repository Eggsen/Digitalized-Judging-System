<%- include('partials/head') %>

<body class="min-h-screen bg-slate-50 font-sans text-slate-800 flex flex-col justify-between antialiased relative overflow-x-hidden"
    data-role="<%= user.role %>"
    data-username="<%= user.username %>"
    data-user-id="<%= user.id %>">

    <div class="dashboard-bg"></div>

    <!-- Header Navigation -->
    <%- include('partials/header') %>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div id="dashboard-layout-container" class="flex flex-col lg:flex-row gap-6 items-start w-full">

            <!-- Sidebar Navigation (Active in Sidebar Mode) -->
            <%- include('partials/sidebar') %>

            <!-- Main Content Area -->
            <div id="dashboard-content-area" class="flex-1 w-full min-w-0 space-y-6">

                <!-- Welcome Card & Navigation Tabs -->
                <%- include('partials/welcome_banner') %>

                <% if (user.role === 'admin') { %>
                    <!-- Admin Tab 1: Events & Competitions -->
                    <%- include('admin/events_tab') %>

                    <!-- Admin Tab 2: Judge Assignments -->
                    <%- include('admin/assignments_tab') %>

                    <!-- Admin Tab 3: User Invitations & Accounts -->
                    <%- include('admin/accounts_tab') %>

                    <!-- Admin Tab 4: System Audit Logs -->
                    <%- include('admin/audit_logs_tab') %>

                    <!-- Admin Tab 5: System Settings Hub -->
                    <%- include('admin/settings_tab') %>
                <% } else { %>
                    <!-- Judge / Tabulator View: Assigned Competitions -->
                    <%- include('user/assigned_events') %>

                    <!-- Judge / Tabulator View: My Activity Logs -->
                    <%- include('user/activity_logs') %>

                    <!-- Judge / Tabulator View: Preferences Only -->
                    <div id="user-preferences-tab" class="user-tab-content bg-white rounded-3xl shadow-xl border border-slate-100 p-6 sm:p-8 hidden">
                        <%- include('components/preferences_section') %>
                    </div>
                <% } %>

            </div> <!-- End #dashboard-content-area -->
        </div> <!-- End #dashboard-layout-container -->
    </main>

    <!-- Modals -->
    <% if (user.role === 'admin') { %>
        <!-- Admin Management Modals -->
        <%- include('admin/modals') %>
    <% } %>

    <!-- Event QR Code Generator & Sharing Modal (Accessible to Admin & Tabulator) -->
    <%- include('modals/qr_modal') %>

    <!-- Judge Scoring Sheet & Submission Summary Modals -->
    <%- include('judge/scoring_modal') %>

    <!-- Live Tabulation Board & Score Breakdown Modals -->
    <%- include('tabulator/tabulation_modal') %>

    <!-- View Event Details Modal (Accessible to All Roles) -->
    <%- include('modals/view_event_modal') %>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Application Script Bundles -->
    <%- include('partials/scripts') %>

</body>
</html>
